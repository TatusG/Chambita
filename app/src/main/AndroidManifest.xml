<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chambita">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Chambita">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LOGIN -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- REGISTRO -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!--HOME CLIENTE-->
        <activity
            android:name=".ui.auth.HomeClienteActivity"
            android:exported="false"
        />

        <!--PERFIL CLIENTE-->
        <activity
            android:name=".ui.auth.PerfilClienteActivity"
            android:exported="false"
        />

        <!--NUEVA SOLICITUD-->
        <activity
            android:name=".ui.auth.NuevaSolicitudActivity"
            android:exported="false"
        />

        <!--EDITAR PERFIL-->
        <activity
            android:name=".ui.auth.EditarPerfilActivity"
            android:exported="false"
        />

        <!--MIS SOLICITUDES-->
        <activity
            android:name=".ui.auth.MisSolicitudesActivity"
            android:exported="false"
        />

        <!--DIRECCIONES-->
        <activity
            android:name=".ui.auth.MisDireccionesActivity"
            android:exported="false"
        />

        <!--METODOS PAGO-->
        <activity
            android:name=".ui.auth.MetodosPagoActivity"
            android:exported="false"
        />

        <!--MENSAJES-->
        <activity
            android:name=".ui.auth.MensajesActivity"
            android:exported="false"
        />

        <!--HISTORIAL PAGOS-->
        <activity
            android:name=".ui.auth.HistorialPagosActivity"
            android:exported="false"
        />

        <!--VISTA CHAT 1:1-->
        <activity
            android:name=".ui.auth.ChatActivity"
            android:exported="false"
        />
    </application>

</manifest>