<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_button_outline_dark.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chambita_fondo_oscuro" />
            <stroke android:width="1.5dp" android:color="@color/chambita_secundario" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/borde_input" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>