<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/blanco"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/chambita_acento"
            android:contentDescription="@string/volver"/>

        <ImageView
            android:id="@+id/imgPerfil"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="52dp"
            android:background="@drawable/bg_avatar_tecnico"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_perfil_chat"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgPerfil"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnOpciones"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreTecnico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/chambita_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvEstadoTecnico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#25A55B"
                android:textSize="13sp"/>

        </LinearLayout>


        <ImageView
            android:id="@+id/btnOpciones"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/chambita_texto_principal"
            android:contentDescription="@string/cd_opciones_chat"/>

    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="80dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>


    <LinearLayout
        android:id="@+id/layoutMensaje"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/blanco"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">


        <ImageButton
            android:id="@+id/btnAdjuntar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/chambita_texto_secundario"
            android:contentDescription="@string/cd_adjuntar"/>


        <ImageButton
            android:id="@+id/btnUbicacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_location"
            app:tint="@color/chambita_texto_secundario"
            android:contentDescription="@string/cd_ubicacion"/>


        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_edittext"
            android:hint="@string/mensaje_hint"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textMultiLine"
            android:autofillHints="message"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"/>


        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:src="@drawable/ic_send"
            app:tint="@android:color/white"
            android:contentDescription="@string/cd_enviar_mensaje"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>