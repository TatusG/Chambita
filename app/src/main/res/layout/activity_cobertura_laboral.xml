<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/blanco"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/chambita_primario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Zonas de Cobertura"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Dónde quieres trabajar?"
                    android:textColor="@color/chambita_primario"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Selecciona hasta 5 distritos donde puedas ofrecer tus servicios hoy mismo."
                    android:textColor="@color/chambita_texto_secundario"
                    android:textSize="14sp" />

                <!-- Lista de Spinners -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTRITO 1 (PRINCIPAL)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/chambita_acento"/>
                    <Spinner
                        android:id="@+id/spDistrito1"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="DISTRITO 2"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spDistrito2"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="DISTRITO 3"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spDistrito3"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="DISTRITO 4"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spDistrito4"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="DISTRITO 5"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spDistrito5"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnGuardarCobertura"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="GUARDAR COBERTURA"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Nav Simulado (NavActivity) -->
        <include layout="@layout/item_estadistica" android:visibility="gone" /> <!-- Solo para padding -->

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
