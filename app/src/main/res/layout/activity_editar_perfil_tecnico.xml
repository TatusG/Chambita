<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo">

    <!-- TOOLBAR -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/blanco"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/chambita_acento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Mi perfil profesional"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Chambita"
            android:textColor="@color/chambita_acento"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="72dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HEADER OSCURO -->
            <View
                android:id="@+id/headerBackground"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_profile_header_dark"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- AVATAR -->
            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_nav_active"
                android:gravity="center"
                android:textColor="@color/chambita_acento"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="CQ" />

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAvatarInitials"
                tools:text="Carlos Quispe" />

            <TextView
                android:id="@+id/txtUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D9E1F2"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtNombre"
                tools:text="Electricista • Lima, Perú" />

            <!-- PROGRESO CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="-30dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/headerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtPorcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chambita_acento"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Perfil completado: 60%" />

                    <ProgressBar
                        android:id="@+id/progresoPerfil"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:progress="60"
                        android:progressTint="@color/figma_blue" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="40dp"
                app:layout_constraintTop_toBottomOf="@id/cardProgreso">

                <!-- ESPECIALIDAD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPECIALIDAD"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEspecialidad"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. Electricista"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp" />

                <!-- DESCRIPCION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="DESCRIPCIÓN PROFESIONAL"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="top"
                    android:hint="Describe tu experiencia..."
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textSize="14sp" />

                <!-- EXPERIENCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="AÑOS DE EXPERIENCIA"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. 5 años"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp" />

                <!-- SERVICIOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="SERVICIOS"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipInstalaciones"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instalaciones"
                        app:chipBackgroundColor="@color/figma_blue"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="0dp"
                        android:textColor="@color/blanco" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReparaciones"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reparaciones"
                        app:chipBackgroundColor="@color/figma_blue"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="0dp"
                        android:textColor="@color/blanco" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMantenimiento"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mtto."
                        app:chipBackgroundColor="@color/figma_blue"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="0dp"
                        android:textColor="@color/blanco" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:id="@+id/btnAnadirServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_address_add"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Añadir"
                        android:textColor="@color/chambita_acento"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- TARIFA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="TARIFA POR HORA (S/)"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etTarifaMin"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:hint="Min: 50"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp" />

                    <Space
                        android:layout_width="16dp"
                        android:layout_height="1dp" />

                    <EditText
                        android:id="@+id/etTarifaMax"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:hint="Max: 80"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- DISTRITO DE RESIDENCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="DISTRITO DE RESIDENCIA"
                    android:textColor="@color/chambita_texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDistrito"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="40dp"
                    android:text="GUARDAR CAMBIOS"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/figma_blue"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/blanco"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="@color/chambita_texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Inicio"
                android:textColor="@color/chambita_texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrabajos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tools"
                app:tint="@color/chambita_texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mis Trabajos"
                android:textColor="@color/chambita_texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMensajes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/chambita_texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mensajes"
                android:textColor="@color/chambita_texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_active"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:tint="@color/blanco" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Perfil"
                android:textColor="@color/chambita_acento"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
