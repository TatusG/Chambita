<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/blanco"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/chambita_primario"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Mi perfil profesional"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chambita"
            android:textColor="@color/chambita_primario"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_header_tecnico"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgPerfil"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_person"/>

                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nombre Técnico"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtUbicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Especialidad • Ciudad"
                    android:textColor="#D9E1F2"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- PROGRESO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-25dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtPorcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perfil completado: 0%"
                        android:textColor="@color/chambita_acento"
                        android:textStyle="bold"/>

                    <ProgressBar
                        android:id="@+id/progresoPerfil"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ESPECIALIDAD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPECIALIDAD"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etEspecialidad"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/chambita_texto_principal"
                    android:textColorHint="@color/chambita_texto_secundario"/>

                <!-- DESCRIPCION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="DESCRIPCIÓN PROFESIONAL"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textColor="@color/chambita_texto_principal"
                    android:textColorHint="@color/chambita_texto_secundario"/>

                <!-- EXPERIENCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="AÑOS DE EXPERIENCIA"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/chambita_texto_principal"/>

                <!-- SERVICIOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="SERVICIOS"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipInstalaciones"
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:text="Instalaciones"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReparaciones"
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:text="Reparaciones"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMantenimiento"
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:text="Mantenimiento"/>

                </com.google.android.material.chip.ChipGroup>

                <!-- TARIFA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="TARIFA POR HORA (S/)"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etTarifaMin"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:hint="Min."
                        android:inputType="number"
                        android:paddingHorizontal="16dp"/>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp"/>

                    <EditText
                        android:id="@+id/etTarifaMax"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:hint="Max."
                        android:inputType="number"
                        android:paddingHorizontal="16dp"/>

                </LinearLayout>

                <!-- DISTRITO DE RESIDENCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="DISTRITO DE RESIDENCIA"
                    android:textAllCaps="true"
                    android:textColor="@color/chambita_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spDistrito"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="16dp"/>

                <!-- BOTON -->
                <Button
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="GUARDAR CAMBIOS"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@color/blanco"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:tint="@color/chambita_texto_secundario"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrabajos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tools"
                android:tint="@color/chambita_texto_secundario"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMensajes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                android:tint="@color/chambita_texto_secundario"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensajes"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- PERFIL ACTIVO -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_nav_active"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_person"
                    android:tint="@android:color/white"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/chambita_primario"
                android:textStyle="bold"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>