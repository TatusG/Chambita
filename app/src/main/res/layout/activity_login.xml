<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo_chambita"
            android:contentDescription="Logo Chambita"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido a Chambita"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/chambita_primario"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encuentra técnicos cerca de ti"
            android:textSize="14sp"
            android:textColor="@color/chambita_texto_secundario"
            android:gravity="center"
            android:layout_marginBottom="36dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="13sp"
            android:textColor="@color/chambita_texto_principal"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:layout_marginBottom="16dp"
            android:maxLines="1"
            android:imeOptions="actionNext" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="13sp"
            android:textColor="@color/chambita_texto_principal"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:maxLines="1"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/tvOlvideContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="@color/chambita_acento"
            android:textSize="13sp"
            android:layout_gravity="end"
            android:padding="4dp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/pbCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INGRESAR"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/chambita_primario"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/borde_input" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  o  " android:textColor="@color/chambita_texto_secundario" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/borde_input" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistro"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CREAR CUENTA"
            android:textColor="@color/chambita_primario"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/chambita_primario"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="@color/chambita_acento"
            android:textSize="14sp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
