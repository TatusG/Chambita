<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!--logo-->
        <ImageView
            android:id="@+id/ivlogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo Chambita"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_titulo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/chambita_texto_principal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitulo"
            android:textSize="14sp"
            android:textColor="@color/chambita_texto_secundario"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSemana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semana 02 - SISE"
            android:textSize="12sp"
            android:textColor="@color/chambita_texto_secundario"
            android:textStyle="italic"
            android:layout_marginBottom="32dp" />

        <!-- Campo correo -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:layout_marginBottom="16dp"
            android:maxLines="1"
            android:imeOptions="actionNext" />

        <!-- Campo contraseña -->
        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:layout_marginBottom="24dp"
            android:maxLines="1"
            android:imeOptions="actionDone" />

        <!-- Botón Ingresar -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_ingresar"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="16dp" />

        <!-- Link registro -->
        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_registro"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:padding="8dp" />
    </LinearLayout>


</ScrollView>