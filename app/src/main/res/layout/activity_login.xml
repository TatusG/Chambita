<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo_chambita"
            android:contentDescription="Logo Chambita"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_titulo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/chambita_primario"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitulo"
            android:textSize="14sp"
            android:textColor="@color/chambita_texto_secundario"
            android:gravity="center"
            android:layout_marginBottom="36dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="13sp"
            android:textColor="@color/chambita_texto_principal"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_edittext"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:layout_marginBottom="16dp"
            android:maxLines="1"
            android:imeOptions="actionNext" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="13sp"
            android:textColor="@color/chambita_texto_principal"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:background="@drawable/bg_edittext"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario"
            android:maxLines="1"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/tvOlvideContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="@color/chambita_acento"
            android:textSize="13sp"
            android:layout_gravity="end"
            android:padding="4dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_ingresar"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_input" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  o  "
                android:textColor="@color/chambita_texto_secundario"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_input" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CREAR CUENTA"
            android:textColor="@color/chambita_primario"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_outline"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_registro"
            android:textColor="@color/chambita_acento"
            android:textSize="14sp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>