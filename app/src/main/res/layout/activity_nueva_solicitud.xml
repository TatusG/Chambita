<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Volver -->

        <TextView
            android:id="@+id/tvVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← VOLVER"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <!-- Título -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva solicitud"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Técnico dinámico -->

        <TextView
            android:id="@+id/tvTecnico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/chambita_texto_secundario"
            android:textSize="16sp" />

        <!-- Descripción -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="DESCRIPCIÓN DEL PROBLEMA"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:gravity="top"
            android:hint="Describe lo que necesitas..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/chambita_texto_principal"
            android:textColorHint="@color/chambita_texto_secundario" />

        <!-- Dirección -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DIRECCIÓN DEL SERVICIO"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spDireccion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext" />

        <!-- Fecha -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="FECHA Y HORA"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutFecha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvFechaHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Seleccionar fecha y hora"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar" />

        </LinearLayout>

        <!-- Categoría -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CATEGORÍA"
            android:textColor="@color/chambita_primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnInstalacion"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Instalación"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/blanco" />

                <Button
                    android:id="@+id/btnReparacion"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="Reparación"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_outline" />

                <Button
                    android:id="@+id/btnMantenimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="Mtto."
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_outline" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Resumen -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Técnico"
                        android:textSize="16sp"
                        android:textColor="@color/chambita_texto_secundario" />

                    <TextView
                        android:id="@+id/tvResumenTecnico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="@color/chambita_texto_principal" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tarifa estimada"
                        android:textSize="16sp"
                        android:textColor="@color/chambita_texto_secundario" />

                    <TextView
                        android:id="@+id/tvTarifa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/chambita_acento"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botones -->

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_primary"
            android:text="CONFIRMAR SERVICIO"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_outline"
            android:text="CANCELAR"
            android:textColor="@color/chambita_primario"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>