<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- Logo Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_nav_active"
                android:padding="8dp"
                android:src="@drawable/ic_tools"
                app:tint="@color/blanco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Chambita"
                android:textColor="@color/chambita_primario"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Regístrate gratis para empezar"
            android:textColor="@color/chambita_texto_secundario"
            android:textSize="14sp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="NOMBRE *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_edittext"
            android:hint="Tu nombre completo"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textSize="15sp" />

        <!-- DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="DNI (8 DÍGITOS) *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDni"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_edittext"
            android:hint="12345678"
            android:inputType="number"
            android:maxLength="8"
            android:paddingHorizontal="16dp"
            android:textSize="15sp" />

        <!-- Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CORREO *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_edittext"
            android:hint="correo@ejemplo.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textSize="15sp" />

        <!-- Teléfono -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="TELÉFONO *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="12dp"
            android:hint="+51 999 999 999"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            app:drawableTint="@color/chambita_texto_secundario" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CONTRASEÑA *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_edittext"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:hint="********"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            app:drawableTint="@color/chambita_texto_secundario" />

        <!-- Confirmar Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CONFIRMAR CONTRASEÑA *"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmarContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_edittext"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:hint="********"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            app:drawableTint="@color/chambita_texto_secundario" />

        <!-- Selector de rol -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="TIPO DE CUENTA"
            android:textColor="@color/chambita_texto_principal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_pill_grey"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnCliente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_figma_blue"
                android:drawableStart="@drawable/ic_person"
                android:paddingStart="20dp"
                app:drawableTint="@color/blanco"
                android:text="Cliente"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTecnico"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_tools"
                android:paddingStart="20dp"
                app:drawableTint="@color/chambita_texto_principal"
                android:text="Técnico"
                android:textAllCaps="false"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botón crear cuenta -->
        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_figma_blue"
            android:drawableEnd="@drawable/ic_arrow_forward"
            android:paddingHorizontal="24dp"
            app:drawableTint="@color/blanco"
            android:text="CREAR CUENTA"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Link login -->
        <TextView
            android:id="@+id/tvIniciarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="8dp"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="@color/chambita_acento"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
