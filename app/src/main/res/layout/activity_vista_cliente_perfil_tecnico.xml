<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chambita_oscuro">

    <!-- TOOLBAR -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/chambita_oscuro"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/blanco" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Perfil Técnico"
            android:textColor="@color/blanco"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNotificaciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bell"
            app:tint="@color/blanco" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="72dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HEADER SECCIÓN -->
            <LinearLayout
                android:id="@+id/llHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="60dp"
                android:paddingTop="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvAvatarTecnico"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_nav_active"
                    android:gravity="center"
                    android:textColor="@color/chambita_acento"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="CG" />

                <TextView
                    android:id="@+id/tvNombreTecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/blanco"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Carlos García" />

                <TextView
                    android:id="@+id/tvEspecialidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.1"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="GASFITERO" />

                <TextView
                    android:id="@+id/tvZonaAtencion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="8dp"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    app:drawableTint="#94A3B8"
                    tools:text="Atiende: Puente Piedra, Ventanilla..." />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <RatingBar
                        android:id="@+id/ratingBarTecnico"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:progressTint="@color/chambita_estrella"
                        android:rating="4" />

                    <TextView
                        android:id="@+id/tvRatingNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/blanco"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="4.0" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD BLANCO OVERLAP -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/llHeader">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="40dp">

                    <!-- Resumen 3 columnas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_grey"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvNumTrabajos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/chambita_texto_principal"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="0" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TRABAJOS"
                                android:textSize="10sp"
                                android:textColor="@color/chambita_texto_secundario" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_grey"
                            android:gravity="center"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">
                                <View
                                    android:id="@+id/viewStatusDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_online_dot"
                                    android:backgroundTint="@color/figma_blue" />
                                <TextView
                                    android:id="@+id/tvEstado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="LIBRE"
                                    android:textColor="@color/figma_blue"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ESTADO"
                                android:textSize="10sp"
                                android:textColor="@color/chambita_texto_secundario" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_grey"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTarifa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/chambita_texto_principal"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="S/ 43.00" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="X HORA"
                                android:textSize="10sp"
                                android:textColor="@color/chambita_texto_secundario" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Chips -->
                    <LinearLayout
                        android:id="@+id/llChipsServicios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal" />

                    <!-- BOTÓN CONTRATAR AZUL -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContratar"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="32dp"
                        android:text="CONTRATAR AHORA  →"
                        android:textColor="@color/blanco"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/chambita_primario"
                        app:cornerRadius="16dp" />

                    <!-- BOTONES LLAMAR Y CHAT GRIS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLlamar"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text=" LLAMAR"
                            android:textColor="@color/blanco"
                            android:textStyle="bold"
                            app:backgroundTint="#1E293B"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_phone"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChat"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text=" CHAT"
                            android:textColor="@color/blanco"
                            android:textStyle="bold"
                            app:backgroundTint="#1E293B"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_chat"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <!-- VER EN MAPA OUTLINED -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerMapa"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="16dp"
                        android:text="VER EN MAPA"
                        android:textColor="@color/chambita_texto_principal"
                        android:textStyle="bold"
                        app:backgroundTint="@color/blanco"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_location"
                        app:iconGravity="textStart"
                        app:iconTint="@color/figma_blue"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="Reseña reciente"
                        android:textColor="@color/chambita_texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvResenas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
