<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgIcono"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_grey"
            android:padding="10dp"
            android:src="@drawable/ic_home"
            app:tint="@color/chambita_primario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAlias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Casa" />

            <TextView
                android:id="@+id/txtDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/chambita_texto_secundario"
                android:textSize="14sp"
                tools:text="Jr. Las Flores 234, Miraflores" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D1FAE5"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="PRINCIPAL"
            android:textColor="#059669"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:textColor="@color/chambita_acento"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
