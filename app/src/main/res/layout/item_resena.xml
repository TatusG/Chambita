<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Cabecera de la reseña: Nombre y Calificación -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Nombre Cliente -->
            <TextView
                android:id="@+id/tvNombreCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="María Delgado"
                android:textColor="@color/chambita_texto_principal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Calificación (Estrellas Reales) -->
            <RatingBar
                android:id="@+id/ratingBarResena"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="1.0"
                android:progressTint="@color/chambita_estrella" />

        </RelativeLayout>

        <!-- Comentario de la reseña -->
        <TextView
            android:id="@+id/tvComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Excelente trabajo, muy puntual y solucionó la fuga de agua rápidamente. Altamente recomendado."
            android:textColor="@color/chambita_texto_secundario"
            android:textSize="13sp" />

        <!-- Recomendación y Fecha -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvRecomienda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="✓ Recomienda a este técnico"
                android:textColor="@color/chambita_verde"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="20/06/2026"
                android:textColor="@color/chambita_texto_claro"
                android:textSize="11sp" />

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
