<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtEspecialidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELECTRICISTA"
                android:textStyle="bold"
                android:textColor="@color/chambita_primario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="PENDIENTE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/chambita_texto_secundario" />

        </RelativeLayout>

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Falla eléctrica en el baño principal..."
            android:textColor="@color/chambita_texto_principal"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#EEEEEE" />

        <LinearLayout
            android:id="@+id/layoutTecnicoAsignado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgFotoTecnico"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_circle_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreTecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Técnico asignado"
                    android:textSize="12sp"
                    android:textColor="@color/chambita_texto_secundario" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnChatTecnico"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_primary"
                android:src="@drawable/ic_chat"
                app:tint="@color/blanco"
                android:padding="10dp"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtMensajeEspera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esperando que un técnico acepte tu solicitud..."
            android:textColor="@color/chambita_texto_secundario"
            android:textSize="14sp"
            android:fontStyle="italic" />

        <Button
            android:id="@+id/btnCalificarServicio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="CALIFICAR SERVICIO"
            android:textColor="@color/chambita_acento"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
